direction: right

terminal: {
  label: "タブレットPOS端末アプリ"
  grid-columns: 2
  style.fill: "#F7FBFF"
  style.stroke: "#9EADCC"
  style.stroke-dash: 4

  app: {
    label: "（1） アプリケーション層"
    grid-rows: 3
    style.fill: "#DDEBF7"
    style.stroke: "#5B9BD5"

    business: "① 画面・業務処理\nデバイス操作を依頼"
    lifecycle: "② アプリライフサイクル\n起動・再開・停止"
    host_manager: "③ デバイスコネクタプロセス管理\n存在確認・起動・停止・終了待機"

    lifecycle -> host_manager
  }

  ctrl: {
    label: "（2） デバイス制御"
    grid-rows: 5
    style.fill: "#E2F0D9"
    style.stroke: "#70AD47"

    config: "④ 設定参照・読込\nデバイス・パイプ設定"
    strategy: "⑤ 使用ストラテジー判定"
    request: "⑥ 要求生成"
    client: "⑦ 名前付きパイプクライアント\nJSON要求・同期応答"
    result: "⑧ 応答変換・返却\nアプリ層へ返却"

    config -> strategy {
      style.stroke-dash: 4
    }
    config -> client {
      style.stroke-dash: 4
    }
    strategy -> request
    request -> client
    client -> result
  }

  app.business -> ctrl.strategy: "操作要求"
  ctrl.result -> app.business: "処理結果"
}

host: {
  label: "（3） デバイスコネクタ"
  grid-columns: 2
  style.fill: "#FCE4D6"
  style.stroke: "#ED7D31"

  support: {
    label: "起動・停止／イベント"
    grid-rows: 3
    style.fill: "#FFF7F2"
    style.stroke: "#F4B183"

    host_control: "⑨ デバイスコネクタ起動・停止管理\n通信・デバイス管理を開始／停止"
    publisher: "⑯ イベント配信\n非同期通知"
    event_pipe: {
      label: "イベント通知用パイプ\n（TabetPos.Host.Event）\n受信側：確認事項"
      style.fill: "#F2F2F2"
      style.stroke-dash: 4
    }

    publisher -> event_pipe {
      style.stroke-dash: 4
    }
  }

  command: {
    label: "デバイス操作要求処理"
    grid-rows: 6
    style.fill: "#FFF7F2"
    style.stroke: "#F4B183"

    server: "⑩ コマンド受付\n要求受付・同期応答"
    router: "⑪ デバイスID別順序制御\n同一デバイスIDを投入順に処理"
    mapper: "⑫ 要求・応答変換\nJSON／デバイスコネクタ内部形式"
    handler: "⑬ コマンド判定・実行\n要求種別を判定"
    manager: "⑭ デバイス管理\n生成・保持・検索・停止"
    impl: "⑮ 個別デバイス実装\nOPOS・OCX等で実機制御"

    server -> router
    router -> mapper
    mapper -> handler
    handler <-> manager
    manager <-> impl
  }

  support.host_control -> command.server
  support.host_control -> command.manager
  command.impl -> support.publisher {
    style.stroke-dash: 4
  }
}

device: {
  label: "（4） 周辺機器"
  grid-rows: 3
  style.fill: "#E4DFEC"
  style.stroke: "#8064A2"

  cash_changer: "⑰ 釣銭機\nRT-300"
  cash_drawer: "⑱ キャッシュドロア\nSHARP"
  customer_display: "⑲ カスタマーディスプレイ\nSHARP"
}

terminal -> host: "" {
  style.opacity: 0
}
terminal -> host.support.host_control: "デバイスコネクタプロセス管理"
host -> device: "" {
  style.opacity: 0
}

terminal.ctrl.client <-> host.command.server: "要求 / 応答"
host.command.impl <-> device.cash_changer
host.command.impl <-> device.cash_drawer
host.command.impl <-> device.customer_display
